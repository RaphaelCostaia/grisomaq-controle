{
  "name": "grisomaq-controle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "GRISOMAQ CONTROLE - PWA offline-first para as fichas de campo da GrisoMaq Servicos Agricolas",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:validar": "node banco/validar-migrations.mjs",
    "db:testar": "node banco/testes/sync.mjs",
    "verificar": "npm run typecheck && npm run servidor:typecheck && npm run test && npm run db:validar && npm run db:testar && npm run servidor:testar",
    "relatorios:exemplo": "vitest run src/relatorios",
    "servidor:testar": "node --test servidor/src/api.teste.ts",
    "servidor:typecheck": "tsc --noEmit -p servidor/tsconfig.json"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@hookform/resolvers": "^5.2.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-table": "^8.21.3",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^1.1.7",
    "exceljs": "^4.4.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.545.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-router": "^7.9.3",
    "recharts": "^3.2.1",
    "sonner": "^2.0.7",
    "uuid": "^11.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
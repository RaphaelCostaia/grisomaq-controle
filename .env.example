# Copie para .env e preencha com os valores do projeto Supabase.
# Apenas variaveis com prefixo VITE_ chegam ao navegador - nunca coloque
# service_role key nem segredo de Edge Function aqui.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Chave publica RSA-OAEP (SPKI, base64) usada para cifrar o PIN no aceite.
# A privada correspondente fica so na Edge Function verificar-assinaturas.
VITE_CHAVE_PUBLICA_ASSINATURA=

# Versao do app enviada em todo push de sincronizacao.
VITE_APP_VERSAO=0.1.0

# Opcional - telemetria de erros em campo.
VITE_SENTRY_DSN=

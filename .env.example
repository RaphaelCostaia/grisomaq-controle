# Variáveis do PWA. Apenas VITE_ chegam ao navegador — nunca coloque segredo
# de servidor aqui. As variáveis do servidor (JWT_SEGREDO, CHAVE_PRIVADA_*)
# ficam no docker-compose ou no EasyPanel.

# URL da API.
#
# VAZIA = mesma origem. O cliente usa caminhos relativos e não precisa saber
# o domínio. É o formato usado tanto no docker-compose local (porta 8080) quanto
# na publicação no EasyPanel — um endereço só, sem CORS.
#
# Preencher com um domínio ('https://api.exemplo.com') só se um dia o app for
# separado da API em domínios distintos.
VITE_API_URL=

# Chave pública RSA-OAEP (SPKI, base64) usada para cifrar o PIN no aceite. A
# privada correspondente fica só no servidor (CHAVE_PRIVADA_ASSINATURA).
# Gere com `node banco/gerar-chaves-assinatura.mjs`.
VITE_CHAVE_PUBLICA_ASSINATURA=

# Versão do app enviada em todo push de sincronização.
VITE_APP_VERSAO=0.1.0

# Opcional — telemetria de erros em campo.
VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Só para docker-compose local (o EasyPanel usa a interface própria):
# ---------------------------------------------------------------------------

# Senha do Postgres local — troque antes de subir.
POSTGRES_PASSWORD=trocar-esta-senha

# Segredo de assinatura do JWT — gere com `openssl rand -base64 48`.
JWT_SEGREDO=

# Chave privada RSA-OAEP correspondente à VITE_CHAVE_PUBLICA_ASSINATURA.
CHAVE_PRIVADA_ASSINATURA=

# Origens permitidas pelo CORS. Com mesma origem, o navegador nunca faz
# preflight — o '*' fica só como formalidade.
ORIGENS_PERMITIDAS=*
